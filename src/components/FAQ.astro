---
import type { FAQItem } from '../utils/schema';

interface Props {
  title?: string;
  items: FAQItem[];
}

const { title = "Frequently Asked Questions", items } = Astro.props;
---

<section class="faq-section">
  <div class="faq-header">
    <h2>{title}</h2>
    <p>Everything you need to know about using sound waves to clean speaker grilles.</p>
  </div>

  <div class="faq-list">
    {items.map((item, index) => (
      <details class="faq-item card" open={index === 0}>
        <summary class="faq-question">
          <span>{item.question}</span>
          <svg class="faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </summary>
        <div class="faq-answer">
          <p>{item.answer}</p>
        </div>
      </details>
    ))}
  </div>
</section>

<style>
  .faq-section {
    margin: 4rem 0;
  }

  .faq-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .faq-header h2 {
    font-size: 2rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 800px;
    margin: 0 auto;
  }

  .faq-item {
    padding: 0;
    overflow: hidden;
  }

  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text-main);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-chevron {
    transition: transform var(--transition-base);
    flex-shrink: 0;
  }

  details[open] .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 1.5rem 1.25rem 1.5rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    border-top: 1px solid var(--color-card-border);
  }

  .faq-answer p {
    margin-top: 1rem;
    margin-bottom: 0;
  }
</style>
