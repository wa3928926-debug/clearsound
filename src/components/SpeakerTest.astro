---
interface Props {
  initialTest?: 'left' | 'right' | 'stereo' | 'all';
}

const { initialTest = 'all' } = Astro.props;
---

<div class="speaker-test-container card" id="speaker-test-app" data-initial-test={initialTest}>
  <div class="test-header">
    <h2>Speaker Diagnostic Suite</h2>
    <p>Test channel isolation, balance, and acoustic frequency output of your device speakers.</p>
  </div>

  <div class="channel-visualizer">
    <div class="speaker-node left-node" id="left-speaker-box">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M11 5L6 9H2v6h4l5 4V5z"/>
        <path d="M15.54 8.46a5 5 0 0 1 0 7.07"/>
      </svg>
      <span>LEFT SPEAKER</span>
    </div>

    <div class="balance-indicator">
      <div class="balance-line">
        <div class="balance-puck" id="balance-puck" style="left: 50%;"></div>
      </div>
      <span class="freq-tag" id="test-freq-tag">Ready</span>
    </div>

    <div class="speaker-node right-node" id="right-speaker-box">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M11 5L6 9H2v6h4l5 4V5z"/>
        <path d="M15.54 8.46a5 5 0 0 1 0 7.07"/>
        <path d="M19.07 4.93a10 10 0 0 1 0 14.14"/>
      </svg>
      <span>RIGHT SPEAKER</span>
    </div>
  </div>

  <div class="test-actions-grid">
    <button class="btn btn-secondary test-btn" data-test="left" id="btn-test-left">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
      <span>Test Left Speaker</span>
    </button>

    <button class="btn btn-secondary test-btn" data-test="right" id="btn-test-right">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
      <span>Test Right Speaker</span>
    </button>

    <button class="btn btn-primary test-btn" data-test="stereo" id="btn-test-stereo">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"/>
        <path d="M12 2a10 10 0 0 0 0 20"/>
      </svg>
      <span>Stereo Balance Test</span>
    </button>

    <button class="btn btn-secondary test-btn" data-test="sweep" id="btn-test-sweep">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/>
        <circle cx="12" cy="12" r="3"/>
      </svg>
      <span>Frequency Sweep</span>
    </button>
  </div>

  <div class="test-controls-row">
    <button class="btn btn-danger" id="btn-test-stop" style="display: none;">Stop Test</button>
    <div class="countdown-badge" id="test-timer-badge">Duration: 10s</div>
  </div>
</div>

<style>
  .speaker-test-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 2.25rem;
    max-width: 720px;
    margin: 0 auto;
  }

  .test-header {
    text-align: center;
  }

  .channel-visualizer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    background: var(--color-bg);
    padding: 2rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-card-border);
  }

  .speaker-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--color-text-muted);
    transition: transform var(--transition-base), color var(--transition-base);
  }

  .speaker-node.active {
    color: var(--color-primary);
    transform: scale(1.15);
  }

  .balance-indicator {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .balance-line {
    width: 100%;
    height: 8px;
    background: var(--color-card-border);
    border-radius: var(--radius-full);
    position: relative;
  }

  .balance-puck {
    width: 20px;
    height: 20px;
    background: var(--color-primary);
    border-radius: 50%;
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 12px var(--color-primary);
    transition: left 200ms ease;
  }

  .freq-tag {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text-main);
  }

  .test-actions-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .test-controls-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .countdown-badge {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-text-muted);
  }

  @media (max-width: 600px) {
    .test-actions-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { SpeakerCleanerEngine } from '../utils/audio';

  document.addEventListener('DOMContentLoaded', () => {
    const leftNode = document.getElementById('left-speaker-box');
    const rightNode = document.getElementById('right-speaker-box');
    const balancePuck = document.getElementById('balance-puck');
    const freqTag = document.getElementById('test-freq-tag');
    const btnStop = document.getElementById('btn-test-stop');
    const timerBadge = document.getElementById('test-timer-badge');
    const testBtns = document.querySelectorAll('#speaker-test-app .test-btn');

    let currentEngine: SpeakerCleanerEngine | null = null;

    const resetNodes = () => {
      leftNode?.classList.remove('active');
      rightNode?.classList.remove('active');
      if (balancePuck) balancePuck.style.left = '50%';
      if (freqTag) freqTag.textContent = 'Ready';
      if (btnStop) btnStop.style.display = 'none';
      if (timerBadge) timerBadge.textContent = 'Duration: 10s';
    };

    const runChannelTest = async (type: string) => {
      if (currentEngine) {
        currentEngine.stop();
      }

      resetNodes();
      if (btnStop) btnStop.style.display = 'inline-flex';

      let seq = [{ duration: 10, frequency: 440, label: 'Testing Tone (440 Hz)' }];
      let channel: 'left' | 'right' | 'stereo' = 'stereo';

      if (type === 'left') {
        channel = 'left';
        leftNode?.classList.add('active');
        if (balancePuck) balancePuck.style.left = '10%';
        if (freqTag) freqTag.textContent = 'Left Channel (440 Hz)';
      } else if (type === 'right') {
        channel = 'right';
        rightNode?.classList.add('active');
        if (balancePuck) balancePuck.style.left = '90%';
        if (freqTag) freqTag.textContent = 'Right Channel (440 Hz)';
      } else if (type === 'stereo') {
        seq = [
          { duration: 4, frequency: 440, label: 'Left Channel' },
          { duration: 4, frequency: 440, label: 'Right Channel' },
          { duration: 4, frequency: 500, label: 'Stereo Both Channels' }
        ];
        leftNode?.classList.add('active');
        rightNode?.classList.add('active');
        if (freqTag) freqTag.textContent = 'Stereo Balance Test';
      } else if (type === 'sweep') {
        seq = [
          { duration: 3, frequency: 100, label: 'Low Frequency (100 Hz)' },
          { duration: 3, frequency: 440, label: 'Mid Frequency (440 Hz)' },
          { duration: 3, frequency: 1000, label: 'High Mid (1000 Hz)' },
          { duration: 3, frequency: 5000, label: 'High Frequency (5000 Hz)' }
        ];
        leftNode?.classList.add('active');
        rightNode?.classList.add('active');
        if (freqTag) freqTag.textContent = 'Frequency Sweep Test';
      }

      currentEngine = new SpeakerCleanerEngine(seq, {
        onStepChange: (_, step) => {
          if (freqTag) freqTag.textContent = step.label;
        },
        onProgress: (elapsed, total) => {
          if (timerBadge) timerBadge.textContent = `Remaining: ${total - elapsed}s`;
        },
        onComplete: () => {
          resetNodes();
          if (freqTag) freqTag.textContent = 'Test Completed Successfully!';
        },
        onError: (err) => {
          resetNodes();
          if (freqTag) freqTag.textContent = err.message;
        }
      });

      await currentEngine.start(channel);
    };

    testBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const type = (e.currentTarget as HTMLButtonElement).dataset.test || 'left';
        runChannelTest(type);
      });
    });

    if (btnStop) {
      btnStop.addEventListener('click', () => {
        if (currentEngine) {
          currentEngine.stop();
        }
        resetNodes();
      });
    }
  });
</script>
