---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-content">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="brand-logo">
          <svg class="logo-icon" viewBox="0 0 100 100" width="32" height="32">
            <rect width="100" height="100" rx="24" fill="#0284c7"/>
            <path d="M 28 38 L 38 38 L 52 26 L 52 74 L 38 62 L 28 62 Z" fill="#ffffff"/>
            <path d="M 60 38 A 16 16 0 0 1 60 62" stroke="#38bdf8" stroke-width="5" stroke-linecap="round" fill="none"/>
          </svg>
          <span class="brand-name">Clear<span class="brand-accent">Sound</span></span>
        </a>
        <p class="brand-desc">
          Independent, browser-based Web Audio utilities engineered to help dislodge dust and water drops from mobile device speakers.
        </p>
      </div>

      <div class="footer-col">
        <h3>Audio Tools</h3>
        <ul>
          <li><a href="/speaker-cleaner/">Speaker Cleaner</a></li>
          <li><a href="/water-eject/">Water Eject Audio</a></li>
          <li><a href="/speaker-test/">Speaker Diagnostic Test</a></li>
          <li><a href="/left-speaker-test/">Left Speaker Test</a></li>
          <li><a href="/right-speaker-test/">Right Speaker Test</a></li>
          <li><a href="/stereo-speaker-test/">Stereo Balance Test</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h3>Device Guides</h3>
        <ul>
          <li><a href="/iphone/iphone-17/">iPhone Speaker Cleaner</a></li>
          <li><a href="/samsung/galaxy-s25-ultra/">Samsung Galaxy Speaker</a></li>
          <li><a href="/xiaomi/redmi-note-14-pro/">Xiaomi Speaker Cleaner</a></li>
          <li><a href="/google-pixel/pixel-10/">Google Pixel Speaker</a></li>
          <li><a href="/ipad/ipad-pro-13/">iPad Speaker Cleaning</a></li>
          <li><a href="/laptop/macbook-air-m3/">Laptop Speaker Cleaner</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h3>Company & Legal</h3>
        <ul>
          <li><a href="/about/">About Us</a></li>
          <li><a href="/contact/">Contact Support</a></li>
          <li><a href="/privacy/">Privacy Policy</a></li>
          <li><a href="/terms/">Terms of Service</a></li>
          <li><a href="/disclaimer/">Safety & Disclaimer</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-disclaimer-box">
      <p>
        <strong>Safety & Hardware Notice:</strong> ClearSound audio tools generate controlled low-frequency acoustic sound waves client-side using the HTML5 Web Audio API. This software is not a guaranteed hardware repair solution. Always listen at a safe volume level and stop immediately if sound output causes discomfort or distortion.
      </p>
    </div>

    <div class="footer-bottom">
      <p>&copy; {currentYear} ClearSound. All rights reserved. Client-side browser application.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #0f172a;
    color: #94a3b8;
    padding: 4rem 0 2rem;
    margin-top: 5rem;
    border-top: 1px solid #1e293b;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    gap: 3rem;
    margin-bottom: 3rem;
  }

  .brand-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.25rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 1rem;
  }

  .brand-accent {
    color: #38bdf8;
  }

  .brand-desc {
    font-size: 0.9rem;
    color: #94a3b8;
    line-height: 1.6;
    max-width: 320px;
  }

  .footer-col h3 {
    color: #ffffff;
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
  }

  .footer-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-col a {
    color: #94a3b8;
    font-size: 0.9rem;
    transition: color var(--transition-fast);
  }

  .footer-col a:hover {
    color: #38bdf8;
  }

  .footer-disclaimer-box {
    background: #1e293b;
    border-left: 4px solid #0284c7;
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius-sm);
    margin-bottom: 2rem;
    font-size: 0.85rem;
    color: #cbd5e1;
  }

  .footer-bottom {
    border-top: 1px solid #1e293b;
    padding-top: 1.5rem;
    text-align: center;
    font-size: 0.85rem;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
