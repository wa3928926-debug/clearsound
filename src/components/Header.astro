---
const pathname = Astro.url.pathname;

const navItems = [
  { name: 'Speaker Cleaner', path: '/speaker-cleaner/' },
  { name: 'Water Eject', path: '/water-eject/' },
  { name: 'Speaker Test', path: '/speaker-test/' },
  { name: 'Articles', path: '/articles/' },
  { name: 'About', path: '/about/' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand-logo" aria-label="ClearSound Homepage">
      <svg class="logo-icon" viewBox="0 0 100 100" width="36" height="36">
        <rect width="100" height="100" rx="24" fill="#0284c7"/>
        <path d="M 28 38 L 38 38 L 52 26 L 52 74 L 38 62 L 28 62 Z" fill="#ffffff"/>
        <path d="M 60 38 A 16 16 0 0 1 60 62" stroke="#38bdf8" stroke-width="5" stroke-linecap="round" fill="none"/>
        <path d="M 68 32 A 26 26 0 0 1 68 68" stroke="#ffffff" stroke-width="4" stroke-linecap="round" fill="none" opacity="0.9"/>
      </svg>
      <span class="brand-name">Clear<span class="brand-accent">Sound</span></span>
    </a>

    <button id="mobile-menu-toggle" class="menu-toggle" aria-label="Toggle navigation menu" aria-expanded="false">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="4" y1="6" x2="20" y2="6"></line>
        <line x1="4" y1="12" x2="20" y2="12"></line>
        <line x1="4" y1="18" x2="20" y2="18"></line>
      </svg>
    </button>

    <nav id="site-nav" class="nav-menu">
      <ul class="nav-list">
        {navItems.map((item) => {
          const isActive = pathname === item.path || (item.path !== '/' && pathname.startsWith(item.path));
          return (
            <li>
              <a href={item.path} class:list={['nav-link', { active: isActive }]}>
                {item.name}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-card-border);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--color-text-main);
  }

  .brand-accent {
    color: var(--color-primary);
  }

  .menu-toggle {
    display: none;
    background: none;
    border: none;
    color: var(--color-text-main);
    padding: 0.5rem;
    cursor: pointer;
    border-radius: var(--radius-sm);
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    list-style: none;
  }

  .nav-link {
    font-weight: 600;
    color: var(--color-text-muted);
    font-size: 0.95rem;
    padding: 0.5rem 0.25rem;
    position: relative;
  }

  .nav-link:hover, .nav-link.active {
    color: var(--color-primary);
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--color-primary);
    border-radius: 2px;
  }

  @media (max-width: 768px) {
    .menu-toggle {
      display: flex;
    }

    .nav-menu {
      display: none;
      position: absolute;
      top: 72px;
      left: 0;
      right: 0;
      background: var(--color-surface);
      border-bottom: 1px solid var(--color-card-border);
      padding: 1.25rem;
      box-shadow: var(--shadow-md);
    }

    .nav-menu.open {
      display: block;
    }

    .nav-list {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .nav-link {
      font-size: 1.1rem;
      width: 100%;
      display: block;
    }
  }
</style>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const navMenu = document.getElementById('site-nav');

  if (toggleBtn && navMenu) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      navMenu.classList.toggle('open');
    });
  }
</script>
