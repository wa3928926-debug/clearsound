---
import type { DeviceInfo } from '../data/devices';

interface Props {
  device: DeviceInfo;
}

const { device } = Astro.props;
---

<a href={`/${device.category}/${device.slug}/`} class="device-card card">
  <div class="device-card-header">
    <span class="device-brand-badge">{device.brand}</span>
    <span class="device-year">{device.year}</span>
  </div>
  <h3 class="device-title">{device.model} Speaker Cleaner</h3>
  <p class="device-desc">{device.description}</p>
  <div class="device-specs-preview">
    <span class="spec-tag">{device.waterRating}</span>
  </div>
  <div class="card-arrow-link">
    <span>Clean {device.model} Speaker</span>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M5 12h14M12 5l7 7-7 7"/>
    </svg>
  </div>
</a>

<style>
  .device-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .device-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .device-brand-badge {
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--color-primary);
    background: var(--color-primary-light);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
  }

  .device-year {
    font-size: 0.8rem;
    color: var(--color-text-light);
    font-weight: 600;
  }

  .device-title {
    font-size: 1.2rem;
    color: var(--color-text-main);
  }

  .device-desc {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    flex-grow: 1;
    margin-bottom: 0;
  }

  .device-specs-preview {
    display: flex;
    gap: 0.5rem;
  }

  .spec-tag {
    font-size: 0.75rem;
    background: var(--color-bg);
    color: var(--color-text-muted);
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-card-border);
  }

  .card-arrow-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-primary);
    margin-top: 0.5rem;
  }

  .device-card:hover .card-arrow-link svg {
    transform: translateX(4px);
    transition: transform var(--transition-fast);
  }
</style>
