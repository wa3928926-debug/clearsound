---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DeviceCard from '../../components/DeviceCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { getDevicesByCategory } from '../../data/devices';

const xiaomis = getDevicesByCategory('xiaomi');
const breadcrumbs = [{ name: 'Xiaomi Guides', url: '/xiaomi/' }];
---

<BaseLayout
  title="Xiaomi Speaker Cleaner Guides"
  description="Select your Xiaomi smartphone model to run browser-based speaker cleaning sound cycles."
>
  <div class="container page-padding">
    <Breadcrumbs items={breadcrumbs} />
    <header class="page-header">
      <h1>Xiaomi Speaker Cleaner Guides</h1>
      <p class="lead-text">Select your Xiaomi model to clear water and dust using Web Audio sound waves.</p>
    </header>
    <div class="devices-grid">
      {xiaomis.map((device) => <DeviceCard device={device} />)}
    </div>
    <RelatedTools />
  </div>
</BaseLayout>

<style>
  .page-padding { padding-top: 2rem; padding-bottom: 4rem; }
  .page-header { text-align: center; max-width: 760px; margin: 0 auto 2.5rem; }
  .lead-text { font-size: 1.15rem; color: var(--color-text-muted); }
  .devices-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem; margin-bottom: 4rem; }
</style>
