---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SpeakerCleaner from '../../components/SpeakerCleaner.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import FAQ from '../../components/FAQ.astro';
import DeviceCard from '../../components/DeviceCard.astro';
import { getDevicesByCategory, type DeviceInfo } from '../../data/devices';

export async function getStaticPaths() {
  const devices = getDevicesByCategory('xiaomi');
  return devices.map((device) => ({
    params: { model: device.slug },
    props: { device }
  }));
}

interface Props {
  device: DeviceInfo;
}

const { device } = Astro.props;
const categoryDevices = getDevicesByCategory('xiaomi').filter(d => d.slug !== device.slug);
const breadcrumbs = [
  { name: 'Xiaomi Guides', url: '/xiaomi/' },
  { name: device.model, url: `/xiaomi/${device.slug}/` }
];

const faqs = [
  {
    question: `How to eject water from ${device.model} speaker?`,
    answer: `Position the device so speaker cutouts face down and play the 60-second sound sequence.`
  }
];
---

<BaseLayout title={device.title} description={device.description} noindex={!device.indexable}>
  <div class="container page-padding">
    <Breadcrumbs items={breadcrumbs} />
    <header class="page-header">
      <span class="badge">{device.brand}</span>
      <h1>{device.model} Speaker Cleaner</h1>
      <p class="lead-text">{device.description}</p>
    </header>

    <main class="tool-main-wrap">
      <SpeakerCleaner sequenceName="cleaner" title={`${device.model} Sound Cleaner`} />
    </main>

    <section class="device-specs-card card">
      <h2>{device.model} Specs</h2>
      <p><strong>Speaker Layout:</strong> {device.speakerLayout}</p>
      <p><strong>Water Resistance:</strong> {device.waterRating}</p>
    </section>

    <FAQ items={faqs} />
    {categoryDevices.length > 0 && (
      <section class="related-devices-section">
        <h2>Other Xiaomi Models</h2>
        <div class="devices-grid">{categoryDevices.map(d => <DeviceCard device={d} />)}</div>
      </section>
    )}
    <RelatedTools />
  </div>
</BaseLayout>

<style>
  .page-padding { padding-top: 2rem; padding-bottom: 4rem; }
  .page-header { text-align: center; max-width: 760px; margin: 0 auto 2.5rem; }
  .lead-text { font-size: 1.15rem; color: var(--color-text-muted); }
  .tool-main-wrap { margin-bottom: 3rem; }
  .device-specs-card { margin: 3rem 0; }
  .related-devices-section { margin: 4rem 0; }
  .related-devices-section h2 { margin-bottom: 2rem; text-align: center; }
  .devices-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; }
</style>
