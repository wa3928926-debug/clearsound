---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SpeakerTest from '../../components/SpeakerTest.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import FAQ from '../../components/FAQ.astro';
import AdPlaceholder from '../../components/AdPlaceholder.astro';

const breadcrumbs = [
  { name: 'Speaker Test', url: '/speaker-test/' },
  { name: 'Left Speaker Test', url: '/left-speaker-test/' }
];

const faqs = [
  {
    question: "What does the Left Speaker Test do?",
    answer: "It isolates sound playback to 100% left channel pan using the Web Audio API, sending a 440 Hz standard pitch tone to verify left speaker functionality."
  }
];
---

<BaseLayout
  title="Left Speaker Test – Online Left Channel Audio Check"
  description="Isolate and test the left speaker channel on your phone or laptop. Free browser-based left channel audio balance test."
>
  <div class="container page-padding">
    <Breadcrumbs items={breadcrumbs} />

    <header class="page-header">
      <h1>Left Speaker Test</h1>
      <p class="lead-text">
        Isolate your left audio channel to verify sound output, balance, and speaker clarity.
      </p>
    </header>

    <main class="tool-main-wrap">
      <SpeakerTest initialTest="left" />
    </main>

    <AdPlaceholder slotId="2004" minHeight="280px" />
    <FAQ items={faqs} />
    <RelatedTools currentToolId="left-speaker-test" />
  </div>
</BaseLayout>

<style>
  .page-padding { padding-top: 2rem; padding-bottom: 4rem; }
  .page-header { text-align: center; max-width: 760px; margin: 0 auto 2.5rem; }
  .lead-text { font-size: 1.15rem; color: var(--color-text-muted); }
  .tool-main-wrap { margin-bottom: 3rem; }
</style>
