---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SpeakerTest from '../../components/SpeakerTest.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import FAQ from '../../components/FAQ.astro';
import AdPlaceholder from '../../components/AdPlaceholder.astro';

const breadcrumbs = [
  { name: 'Speaker Test', url: '/speaker-test/' },
  { name: 'Right Speaker Test', url: '/right-speaker-test/' }
];

const faqs = [
  {
    question: "What does the Right Speaker Test do?",
    answer: "It isolates sound playback to 100% right channel pan, playing a 440 Hz test tone to diagnose right speaker output and physical hardware response."
  }
];
---

<BaseLayout
  title="Right Speaker Test – Online Right Channel Audio Check"
  description="Isolate and test the right speaker channel on your phone, tablet, or laptop. Free online right audio channel test."
>
  <div class="container page-padding">
    <Breadcrumbs items={breadcrumbs} />

    <header class="page-header">
      <h1>Right Speaker Test</h1>
      <p class="lead-text">
        Isolate your right audio channel to verify sound output, balance, and speaker performance.
      </p>
    </header>

    <main class="tool-main-wrap">
      <SpeakerTest initialTest="right" />
    </main>

    <AdPlaceholder slotId="2005" minHeight="280px" />
    <FAQ items={faqs} />
    <RelatedTools currentToolId="right-speaker-test" />
  </div>
</BaseLayout>

<style>
  .page-padding { padding-top: 2rem; padding-bottom: 4rem; }
  .page-header { text-align: center; max-width: 760px; margin: 0 auto 2.5rem; }
  .lead-text { font-size: 1.15rem; color: var(--color-text-muted); }
  .tool-main-wrap { margin-bottom: 3rem; }
</style>
