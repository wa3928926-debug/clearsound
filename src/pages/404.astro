---
import BaseLayout from '../layouts/BaseLayout.astro';
import RelatedTools from '../components/RelatedTools.astro';
---

<BaseLayout
  title="404 Page Not Found – ClearSound"
  description="The requested page could not be found. Return to ClearSound speaker cleaner or audio test tools."
  noindex={true}
>
  <div class="container page-padding">
    <div class="error-404-card card">
      <div class="error-code">404</div>
      <h1>Page Not Found</h1>
      <p class="lead-text">
        The page you are looking for may have been moved, renamed, or is temporarily unavailable.
      </p>

      <div class="action-btn-group">
        <a href="/speaker-cleaner/" class="btn btn-primary btn-lg">Speaker Cleaner</a>
        <a href="/speaker-test/" class="btn btn-secondary btn-lg">Speaker Test</a>
        <a href="/" class="btn btn-secondary btn-lg">Go to Homepage</a>
      </div>
    </div>

    <RelatedTools />
  </div>
</BaseLayout>

<style>
  .page-padding { padding-top: 3rem; padding-bottom: 4rem; }
  .error-404-card { max-width: 680px; margin: 0 auto 4rem; text-align: center; padding: 3.5rem 2rem; display: flex; flex-direction: column; align-items: center; gap: 1rem; }
  .error-code { font-size: 5rem; font-weight: 800; color: var(--color-primary); line-height: 1; }
  .error-404-card h1 { font-size: 2rem; font-weight: 800; }
  .lead-text { font-size: 1.1rem; color: var(--color-text-muted); max-width: 500px; }
  .action-btn-group { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; margin-top: 1rem; }
</style>
