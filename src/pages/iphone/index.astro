---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DeviceCard from '../../components/DeviceCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { getDevicesByCategory } from '../../data/devices';

const iphones = getDevicesByCategory('iphone');
const breadcrumbs = [{ name: 'iPhone Guides', url: '/iphone/' }];
---

<BaseLayout
  title="iPhone Speaker Cleaner Guides – All Models"
  description="Select your iPhone model to access tailored speaker cleaner sound utilities and moisture ejection guidance."
>
  <div class="container page-padding">
    <Breadcrumbs items={breadcrumbs} />

    <header class="page-header">
      <h1>iPhone Speaker Cleaner Guides</h1>
      <p class="lead-text">
        Select your specific iPhone model to view speaker acoustic port layouts and run customized sound cleaning cycles.
      </p>
    </header>

    <div class="devices-grid">
      {iphones.map((device) => (
        <DeviceCard device={device} />
      ))}
    </div>

    <RelatedTools />
  </div>
</BaseLayout>

<style>
  .page-padding { padding-top: 2rem; padding-bottom: 4rem; }
  .page-header { text-align: center; max-width: 760px; margin: 0 auto 2.5rem; }
  .lead-text { font-size: 1.15rem; color: var(--color-text-muted); }
  .devices-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem; margin-bottom: 4rem; }
</style>
