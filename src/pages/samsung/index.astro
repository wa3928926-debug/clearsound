---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DeviceCard from '../../components/DeviceCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { getDevicesByCategory } from '../../data/devices';

const samsungs = getDevicesByCategory('samsung');
const breadcrumbs = [{ name: 'Samsung Guides', url: '/samsung/' }];
---

<BaseLayout
  title="Samsung Galaxy Speaker Cleaner Guides"
  description="Select your Samsung Galaxy model to view model-specific speaker cleaning sound utilities and liquid ejection steps."
>
  <div class="container page-padding">
    <Breadcrumbs items={breadcrumbs} />
    <header class="page-header">
      <h1>Samsung Galaxy Speaker Cleaner Guides</h1>
      <p class="lead-text">Select your Samsung model to run customized speaker cleaning sound sequences.</p>
    </header>
    <div class="devices-grid">
      {samsungs.map((device) => <DeviceCard device={device} />)}
    </div>
    <RelatedTools />
  </div>
</BaseLayout>

<style>
  .page-padding { padding-top: 2rem; padding-bottom: 4rem; }
  .page-header { text-align: center; max-width: 760px; margin: 0 auto 2.5rem; }
  .lead-text { font-size: 1.15rem; color: var(--color-text-muted); }
  .devices-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem; margin-bottom: 4rem; }
</style>
